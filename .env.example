# ── الرابط الأساسي للموقع (مهم للـ SEO وخرائط الموقع) ─────────────────
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Supabase: الحسابات والوصول المدفوع ───────────────────────────────
# من لوحة Supabase → Project Settings → API
# الموقع بيشتغل من غيرهم، بس ميزات الحساب بتختفي
NEXT_PUBLIC_SUPABASE_URL=https://kcuyctrchvfdjiyggkau.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ المفتاح ده بيتخطّى كل سياسات الأمان.
#    ممنوع يبدأ بـNEXT_PUBLIC_ وممنوع يتستورد في أي مكوّن فيه "use client"
SUPABASE_SERVICE_ROLE_KEY=

# ── بوابات الدفع (اختياري — تتفعّل لما تحطّ المفاتيح) ────────────────
# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Paymob (مصر)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# ── استقبال رسائل النموذج (اختياري) ──────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# ── النشرة البريدية (اختياري) ────────────────────────────────────────
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# ── التحليلات (اختياري) ──────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
